{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base", "hidden": true,
            "generator": "Visual Studio 17 2022", "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"       
            }
        },
        {
            "name": "release without pdb",
            "inherits": "base",
            "displayName": "Release without pdb",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_RELEASE_PDB": "OFF"
            }
        },
        {
            "name": "release with pdb",
            "inherits": "base",
            "displayName": "Release with pdb",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_RELEASE_PDB": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release without pdb",
            "configuration": "Release",
            "configurePreset": "release without pdb"
        },
        {
            "name": "release with pdb",
            "configuration": "Release",
            "configurePreset": "release with pdb"
        },
        {
            "name": "debug",
            "configuration": "Debug",
            "configurePreset": "debug"
        }

    ]
}